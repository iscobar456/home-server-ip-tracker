#!/bin/bash

# File to store the current IP
IP_FILE="/var/lib/misc/current_ip.txt"
S3_URI="s3://isaac-spencer-misc/home_server_IPs/raspberrypi.txt"

# Fetch current public IP
CURRENT_IP=$(curl -s https://ifconfig.me)

# Check if the IP file exists
if [ -f "$IP_FILE" ]; then
    # Read the saved IP from the file
    SAVED_IP=$(cat "$IP_FILE")
else
    SAVED_IP=""
fi

# Compare current IP with the saved IP
if [ "$CURRENT_IP" != "$SAVED_IP" ]; then
    # If the IP has changed, save the new IP to the file
    echo "$CURRENT_IP" > "$IP_FILE"

    # Upload the updated file to S3
    aws s3 cp "$IP_FILE" "$S3_URI"

    echo "IP address updated and uploaded to S3: $CURRENT_IP"
else
    echo "IP address has not changed: $CURRENT_IP"
fi

